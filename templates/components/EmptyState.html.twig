{#
    Shown instead of an empty list.

    <twig:EmptyState message="Aucun projet pour l'instant.">
        <twig:Button>Créer un projet</twig:Button>
    </twig:EmptyState>
#}
{% props message, icon = 'lucide:inbox' %}

<div {{ attributes.defaults({class: 'flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center'}) }}>
    <span class="grid size-10 place-items-center rounded-full bg-gray-100 text-gray-500">
        {{ ux_icon(icon, {class: 'size-5', 'aria-hidden': 'true'}) }}
    </span>
    <p class="text-sm text-gray-500 italic">{{ message }}</p>
    {% block content %}{% endblock %}
</div>
