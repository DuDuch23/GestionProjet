{#
    Page title (the page's only <h1>) with optional subtitle and actions.

    <twig:PageHeader title="Projets" subtitle="12 projets actifs">
        <twig:block name="actions">
            <twig:Button>Nouveau projet</twig:Button>
        </twig:block>
    </twig:PageHeader>
#}
{% props title, subtitle = null %}

<div {{ attributes.defaults({class: 'mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between'}) }}>
    <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">{{ title }}</h1>
        {% if subtitle %}<p class="mt-1 text-sm text-gray-500">{{ subtitle }}</p>{% endif %}
    </div>
    <div class="flex flex-wrap items-center gap-2">{% block actions %}{% endblock %}</div>
</div>
