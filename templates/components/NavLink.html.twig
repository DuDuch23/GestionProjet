{#
    Navigation link, highlighted when the current route matches
    (exactly, or as a prefix: "project" is active on "project_show").

    <twig:NavLink route="project">Projets</twig:NavLink>
    <twig:NavLink route="project" mobile>Projets</twig:NavLink>
#}
{% props route, mobile = false %}

{% set current = app.current_route ?? '' %}
{% set active = current == route or current starts with route ~ '_' %}

{% set classes = (mobile ? 'block rounded-lg px-3 py-2 text-base' : 'rounded-lg px-3 py-2 text-sm')
    ~ ' font-medium transition-colors '
    ~ (active ? 'bg-gray-100 text-gray-900 underline decoration-2 underline-offset-4' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900') %}

<a href="{{ path(route) }}" {{ attributes.defaults({class: classes}) }}{% if active %} aria-current="page"{% endif %}>
    {%- block content %}{% endblock -%}
</a>
