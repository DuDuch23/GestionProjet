{% extends 'base.html.twig' %}

{% block title %}Clients · GestionProjet{% endblock %}

{% block body %}
    {# clients is a pagination object: |length = clients on this page, totalItems = all clients #}
    <twig:PageHeader title="Clients" :subtitle="clients.totalItems ~ (clients.totalItems > 1 ? ' clients' : ' client')" />

    {% if clients is empty %}
        <twig:EmptyState message="Aucun client pour l'instant." icon="lucide:user" />
    {% else %}
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <twig:Button variant="secondary" size="sm" icon="lucide:funnel">Filtrer</twig:Button>
            <twig:Button variant="secondary" size="sm" icon="lucide:arrow-up-down">Trier</twig:Button>
            <twig:Button variant="secondary" size="sm" icon="lucide:layers">Grouper</twig:Button>
            <twig:Button variant="ghost" size="sm" icon="lucide:plus">Ajouter une colonne</twig:Button>
        </div>

        <twig:Card :padded="false" class="overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm">
                    <thead class="bg-gray-50">
                        <tr class="text-left text-xs font-medium tracking-wide text-gray-500 uppercase">
                            <th scope="col" class="px-4 py-3">Nom prénom</th>
                            <th scope="col" class="px-4 py-3">Email</th>
                            <th scope="col" class="px-4 py-3">Téléphone</th>
                            <th scope="col" class="px-4 py-3">Projet</th>
                            <th scope="col" class="px-4 py-3">Mis à jour</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-white">
                        {% for client in clients %}
                            <tr class="align-top transition-colors hover:bg-gray-50">
                                <td class="px-4 py-3 whitespace-nowrap">
                                    <p class="text-gray-700">{{ client.fullName }}</p>
                                    {% if client.company %}
                                        <p class="text-xs text-gray-500">{{ client.company }}</p>
                                    {% endif %}
                                </td>
                                <td class="max-w-sm px-4 py-3">
                                    {% if client.email %}
                                        <a href="mailto:{{ client.email }}" class="font-medium text-gray-900 hover:underline">{{ client.email }}</a>
                                    {% else %}
                                        <span class="text-gray-400">—</span>
                                    {% endif %}
                                </td>
                                {# <td class="px-4 py-3"><twig:PriorityBadge :priority="project.priority" /></td>
                                <td class="px-4 py-3"><twig:StatusBadge :status="project.status" /></td> #}
                                <td class="px-4 py-3 whitespace-nowrap">
                                    {% if client.phone %}
                                        <p class="text-gray-700">{{ client.phone }}</p>
                                    {% else %}
                                        <span class="text-gray-400">—</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3">
                                    {% for project in client.projects|filter(p => not p.deleted) %}
                                        <p class="text-gray-900">{{ project.name }}</p>
                                    {% else %}
                                        <span class="text-gray-400">—</span>
                                    {% endfor %}
                                </td>
                                <td class="px-4 py-3 whitespace-nowrap text-gray-500">{{ client.updatedAt|date('d/m/Y') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Card>

        {{ ux_pagination(clients) }}
    {% endif %}
{% endblock %}
