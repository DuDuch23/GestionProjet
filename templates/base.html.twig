<!DOCTYPE html>
<html lang="fr" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}GestionProjet{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23111827%22/><path d=%22M9 11h14M9 16h10M9 21h6%22 stroke=%22white%22 stroke-width=%222.5%22 stroke-linecap=%22round%22/></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="flex min-h-full flex-col">
        <header class="sticky top-0 z-40 border-b border-gray-200 bg-white/90 backdrop-blur" data-controller="mobile-menu">
            <div class="mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between gap-6 px-6">
                <a href="{{ path('home') }}" class="flex items-center gap-2 text-sm font-semibold text-gray-900">
                    <span class="grid size-8 place-items-center rounded-lg bg-gray-900 text-white">
                        {{ ux_icon('lucide:folder-kanban', {class: 'size-4', 'aria-hidden': 'true'}) }}
                    </span>
                    GestionProjet
                </a>

                <nav class="hidden items-center gap-1 md:flex" aria-label="Navigation principale">
                    <twig:NavLink route="home">Accueil</twig:NavLink>
                    <twig:NavLink route="project">Projets</twig:NavLink>
                    <twig:NavLink route="client" mobile>Clients</twig:NavLink>
                </nav>

                <button type="button"
                        class="-mr-2 grid size-10 place-items-center rounded-lg text-gray-600 hover:bg-gray-100 hover:text-gray-900 md:hidden"
                        aria-controls="mobile-nav" aria-expanded="false" aria-label="Ouvrir le menu"
                        data-action="mobile-menu#toggle" data-mobile-menu-target="button">
                    <span data-mobile-menu-target="openIcon">{{ ux_icon('lucide:menu', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                    <span class="hidden" data-mobile-menu-target="closeIcon">{{ ux_icon('lucide:x', {class: 'size-5', 'aria-hidden': 'true'}) }}</span>
                </button>
            </div>

            <nav id="mobile-nav" class="hidden border-t border-gray-200 px-4 py-3 md:hidden" aria-label="Navigation mobile" data-mobile-menu-target="menu">
                <twig:NavLink route="home" mobile>Accueil</twig:NavLink>
                <twig:NavLink route="project" mobile>Projets</twig:NavLink>
                <twig:NavLink route="client" mobile>Clients</twig:NavLink>
            </nav>
        </header>

        <main class="mx-auto w-full max-w-[1280px] flex-1 px-6 py-12">
            {% set flash_types = {success: 'success', error: 'error', danger: 'error', warning: 'warning', info: 'info', notice: 'info'} %}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <twig:Alert :type="flash_types[type] ?? 'info'" class="mb-6">{{ message }}</twig:Alert>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="border-t border-gray-200 bg-white">
            <div class="mx-auto w-full max-w-[1280px] px-6 py-6 text-xs text-gray-500">
                GestionProjet · {{ 'now'|date('Y') }}
            </div>
        </footer>
    </body>
</html>
