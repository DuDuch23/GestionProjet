# ---------------------------------------------------------------------------
# Template for your local development settings.
#
#   1. Copy this file:   cp .env.local.example .env.local
#   2. Fill in the values below.
#
# .env.local is git-ignored: put your real values and secrets there, never in
# .env / .env.dev / .env.test (those are committed and hold defaults only).
# ---------------------------------------------------------------------------

# REQUIRED. Random secret used to sign CSRF tokens, "remember me" cookies, etc.
# Generate one (64 hex chars) with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Database. The default in .env targets XAMPP's MariaDB (user "root", no password).
# Override it if your user, password, port or server version differ:
#   mysql://USER:PASSWORD@127.0.0.1:3306/gestion_projet?serverVersion=10.4.32-MariaDB&charset=utf8mb4
# DATABASE_URL="mysql://root:@127.0.0.1:3306/gestion_projet?serverVersion=10.4.32-MariaDB&charset=utf8mb4"

# Base URL used when generating absolute URLs outside HTTP requests (commands, emails).
DEFAULT_URI=https://127.0.0.1:8000

# Emails: null://null discards them. To read them in Mailpit (docker compose up mailer):
# MAILER_DSN=smtp://127.0.0.1:1025

# ---------------------------------------------------------------------------
# Tests use .env + .env.test, NOT .env.local. If your database needs a password,
# also create .env.test.local (git-ignored) with the same DATABASE_URL:
# the "_test" suffix is added automatically (database gestion_projet_test).
# ---------------------------------------------------------------------------
